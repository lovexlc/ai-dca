# Cloudflare API (已配置)
CLOUDFLARE_API_TOKEN=your_cloudflare_token
CLOUDFLARE_ACCOUNT_ID=your_account_id
CF_API_TOKEN=your_cloudflare_token
CF_ACCOUNT_ID=your_account_id

# GitHub API (已配置)
GITHUB_TOKEN=your_github_token
GH_TOKEN=your_github_token

# PostHog 埋点分析 (可选)
# 注册免费账号: https://posthog.com/
# 获取 API Key 后填写以下配置
VITE_POSTHOG_API_KEY=phc_placeholder
VITE_POSTHOG_HOST=https://app.posthog.com

# 地区横幅（国内 / 海外域名互相引导）
# - VITE_SITE_REGION: 当前这份部署面向的地区，cn 或 global；留空则只按域名比对
# - VITE_SITE_ORIGIN_CN: 国内站点域名
# - VITE_SITE_ORIGIN_GLOBAL: 海外站点域名
# 两个域名都留空时横幅不会展示
VITE_SITE_REGION=
VITE_SITE_ORIGIN_CN=
VITE_SITE_ORIGIN_GLOBAL=

# 说明:
# - 如不使用 PostHog，保持 VITE_POSTHOG_API_KEY=phc_placeholder 即可
# - PostHog 免费额度: 100万事件/月
# - 详细配置见: docs/POSTHOG_SETUP.md
